            formTitle.textContent = "Ficha Estratégica - Editando";
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Save or update data to Firestore
        saveBtn.addEventListener('click', async () => {
            showLoading();
            const formData = {
                ...getFormData(),
                userId: userId, // Add userId to the data
                timestamp: new Date() // Add a timestamp
            };
            
            try {
                if (currentDocId) {
                    const privateDocRef = doc(db, `/artifacts/${appId}/users/${userId}/fichas`, currentDocId);
                    const publicDocRef = doc(db, publicCollectionPath, currentDocId);
                    await setDoc(privateDocRef, formData, { merge: true });
                    await setDoc(publicDocRef, formData, { merge: true });
                    showMessage("Ficha atualizada com sucesso!");
                    console.log("Documento atualizado com sucesso:", currentDocId);
                } else {
                    const privateCollectionRef = collection(db, `/artifacts/${appId}/users/${userId}/fichas`);
                    const publicCollectionRef = collection(db, publicCollectionPath);
                    const privateDocRef = await addDoc(privateCollectionRef, formData);
                    await setDoc(doc(publicCollectionRef, privateDocRef.id), formData);
                    showMessage("Ficha salva com sucesso!");
                    console.log("Documento salvo com ID:", privateDocRef.id);
                }
            } catch (e) {
                console.error("Erro ao salvar documento: ", e);
                showMessage("Erro ao salvar a ficha. Por favor, tente novamente.");
            } finally {
                hideLoading();
            }
        });
        
