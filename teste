                interacoesOrgao: document.getElementById('interacoesOrgao').value,
                pendenciasTecnicas: document.getElementById('pendenciasTecnicas').value,
                observacoesAdicionais: document.getElementById('observacoesAdicionais').value
            };

            const riscos = Array.from(riscosTableBody.querySelectorAll('tr')).map(row => {
                const inputs = Array.from(row.querySelectorAll('input'));
                return inputs.map(input => input.value);
            });
            
            const criticidade = Array.from(document.querySelectorAll('#criticidadeTable tbody tr')).map(row => {
                const selectedRadio = row.querySelector('input[type="radio"]:checked');
                const obs = row.querySelector('input[type="text"]');
                return {
                    criticidade: row.querySelector('td:first-child').textContent.trim(),
                    situacao: selectedRadio ? selectedRadio.value : '',
                    observacoes: obs.value
                };
            });

            const decisoes = Array.from(decisoesTableBody.querySelectorAll('tr')).map(row => {
                const inputs = Array.from(row.querySelectorAll('input'));
                return {
                    decisao: inputs[0].value,
                    responsavel: inputs[1].value,
                    prazo: inputs[2].value,
                    proximaReuniao: inputs[3].value
                };
            });
            
            return {
                identificacao,
                riscos,
                criticidade,
                decisoes
            };
        }

        // Function to set all form data
        function loadFormData(data) {
            if (!data) return;

            // Clear the form and set a new document ID
            clearForm();
            currentDocId = data.docId;

            // Identificação
            if (data.identificacao) {
                document.getElementById('empreendimento').value = data.identificacao.empreendimento || '';
                document.getElementById('responsavel').value = data.identificacao.responsavel || '';
                document.getElementById('dataPreenchimento').value = data.identificacao.dataPreenchimento || '';
