<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Plataforma de Licenciamento Ambiental</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f3f4f6;
            color: #1f2937;
            transition: background-color 0.3s, color 0.3s;
        }
        .card {
            background-color: #ffffff;
            border-radius: 1rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        input, select, textarea {
            border: 1px solid #d1d5db;
            padding: 0.5rem 0.75rem;
            border-radius: 0.5rem;
            width: 100%;
            transition: all 0.2s;
            background-color: #ffffff;
            color: #1f2937;
        }
        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: #4338ca;
            box-shadow: 0 0 0 2px rgba(67, 56, 202, 0.25);
        }
        .btn-primary {
            background-color: #4338ca;
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 0.75rem;
            font-weight: 600;
            transition: background-color 0.2s;
        }
        .btn-primary:hover {
            background-color: #312e81;
        }
        .btn-secondary {
            background-color: #e5e7eb;
            color: #4b5563;
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            font-weight: 500;
            transition: background-color 0.2s;
        }
        .btn-secondary:hover {
            background-color: #d1d5db;
        }
        .table-custom {
            width: 100%;
            border-collapse: collapse;
        }
        .table-custom th, .table-custom td {
            border: 1px solid #e5e7eb;
            padding: 0.75rem;
            text-align: left;
        }
        .table-custom th {
            background-color: #f9fafb;
            font-weight: 600;
            color: #1f2937;
        }
        .table-custom tr:nth-child(even) {
            background-color: #f9fafb;
        }
        .status-option {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.5rem;
            border-radius: 9999px;
            cursor: pointer;
            transition: all 0.2s;
            border: 2px solid transparent;
        }
        input[type="radio"]:checked + .status-option {
            border-color: #4338ca;
            box-shadow: 0 0 0 2px rgba(67, 56, 202, 0.25);
        }
        .status-option:hover {
            opacity: 0.8;
        }
        .message-box {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: #fff;
            padding: 2rem;
            border-radius: 1rem;
            box-shadow: 0 10px 15px rgba(0,0,0,0.2);
            z-index: 100;
            text-align: center;
        }
        .all-records-panel {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.7);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 90;
        }
        .all-records-content {
            background-color: white;
            padding: 2rem;
            border-radius: 1rem;
            max-width: 1200px;
            width: 95%;
            max-height: 90%;
            overflow-y: auto;
            position: relative;
        }
        .collapsible-header {
            cursor: pointer;
            padding: 0.5rem 0;
            font-weight: 600;
            display: flex;
            align-items: center;
            flex-grow: 1;
        }
        .collapsible-content {
            padding: 1rem;
            border: 1px solid #e5e7eb;
            border-top: none;
            border-radius: 0 0 0.5rem 0.5rem;
        }
        .collapsible-content-wrapper {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-in-out;
        }
        .status-pill {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
        }
        .status-alto, .status-perita {
            background-color: #dc2626;
            color: #ffffff;
        }
        .status-medio {
            background-color: #f59e0b;
            color: #ffffff;
        }
        .status-baixo {
            background-color: #16a34a;
            color: #ffffff;
        }
        .loading-indicator {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 110;
            padding: 1rem 2rem;
            background-color: rgba(0,0,0,0.7);
            color: white;
            border-radius: 0.5rem;
            font-size: 1.25rem;
        }

        /* Dark Mode Styles */
        body.dark {
            background-color: #1f2937;
            color: #e5e7eb;
        }
        body.dark .card {
            background-color: #374151;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.5);
        }
        body.dark input, body.dark select, body.dark textarea {
            background-color: #4b5563;
            border-color: #6b7280;
            color: #e5e7eb;
        }
        body.dark input:focus, body.dark select:focus, body.dark textarea:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.25);
        }
        body.dark .btn-secondary {
            background-color: #4b5563;
            color: #e5e7eb;
        }
        body.dark .btn-secondary:hover {
            background-color: #6b7280;
        }
        body.dark .table-custom th {
            background-color: #4b5563;
            color: #e5e7eb;
        }
        body.dark .table-custom tr:nth-child(even) {
            background-color: #4b5563;
        }
        body.dark .table-custom th, body.dark .table-custom td {
            border-color: #4b5563;
        }
        body.dark .message-box, body.dark .all-records-content {
            background-color: #374151;
            color: #e5e7eb;
        }
        body.dark .collapsible-header {
            background-color: #4b5563;
        }
        body.dark .collapsible-content {
            border-color: #4b5563;
        }
    </style>
</head>
