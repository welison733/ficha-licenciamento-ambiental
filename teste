                    `;
                    riscosTableBody.appendChild(newRow);
                });
            }
            
            // Criticidade
            if (data.criticidade && Array.isArray(data.criticidade)) {
                const rows = document.querySelectorAll('#criticidadeTable tbody tr');
                data.criticidade.forEach((crit, index) => {
                    if (rows[index]) {
                        const radio = rows[index].querySelector(`input[value="${crit.situacao}"]`);
                        if (radio) {
                            radio.checked = true;
                        }
                        rows[index].querySelector('input[type="text"]').value = crit.observacoes || '';
