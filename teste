                    if (data.riscos && Array.isArray(data.riscos) && data.riscos.length > 0) {
                        const riscosTableHeader = `
                            <h4 class="font-bold text-lg mt-4 mb-2 text-indigo-700">Principais Riscos/Bloqueios</h4>
                            <div class="overflow-x-auto">
                                <table class="table-custom">
                                    <thead>
                                        <tr>
                                            <th>Risco/Bloqueio</th>
                                            <th>Probabilidade</th>
                                            <th>Impacto</th>
                                            <th>Encaminhamento</th>
                                            <th>Justificativa</th>
                                            <th>Responsável</th>
                                            <th>Prazo</th>
                                            <th>Execução</th>
                                            <th>Indicador de Sucesso</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                        `;
                        const riscosTableRows = data.riscos.map(row => `
                            <tr>
                                <td>${row[0] || 'N/A'}</td>
                                <td>${row[1] || 'N/A'}</td>
                                <td>${row[2] || 'N/A'}</td>
                                <td>${row[3] || 'N/A'}</td>
                                <td>${row[4] || 'N/A'}</td>
                                <td>${row[5] || 'N/A'}</td>
                                <td>${row[6] || 'N/A'}</td>
                                <td>${row[7] || 'N/A'}</td>
                                <td>${row[8] || 'N/A'}</td>
                            </tr>
                        `).join('');
                        const riscosTableFooter = `
                                    </tbody>
                                </table>
                            </div>
                        `;
                        riscosHtml = riscosTableHeader + riscosTableRows + riscosTableFooter;
                    }

                    let criticidadeHtml = '';
                    if (data.criticidade && Array.isArray(data.criticidade) && data.criticidade.length > 0) {
                        const criticidadeTableHeader = `
                            <h4 class="font-bold text-lg mt-4 mb-2 text-indigo-700">Checklist de Criticidade</h4>
                            <div class="overflow-x-auto">
                                <table class="table-custom">
                                    <thead>
                                        <tr>
                                            <th>Criticidade</th>
                                            <th>Situação</th>
                                            <th>Observações</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                        `;
                        const criticidadeTableRows = data.criticidade.map(crit => `
                            <tr>
                                <td>${crit.criticidade || 'N/A'}</td>
                                <td>
                                    <span class="status-pill status-${crit.situacao.toLowerCase()}">
                                        ${crit.situacao || 'N/A'}
                                    </span>
                                </td>
                                <td>${crit.observacoes || 'N/A'}</td>
                            </tr>
                        `).join('');
                        const criticidadeTableFooter = `
                                    </tbody>
                                </table>
                            </div>
                        `;
                        criticidadeHtml = criticidadeTableHeader + criticidadeTableRows + criticidadeTableFooter;
                    }

                    let decisoesHtml = '';
                    if (data.decisoes && Array.isArray(data.decisoes) && data.decisoes.length > 0) {
                        const decisoesTableHeader = `
                            <h4 class="font-bold text-lg mt-4 mb-2 text-indigo-700">Decisões da Reunião</h4>
                            <div class="overflow-x-auto">
                                <table class="table-custom">
                                    <thead>
                                        <tr>
                                            <th>Decisão</th>
                                            <th>Responsável</th>
                                            <th>Prazo</th>
                                            <th>Próxima Reunião</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                        `;
                        const decisoesTableRows = data.decisoes.map(decisao => `
                            <tr>
                                <td>${decisao.decisao || 'N/A'}</td>
                                <td>${decisao.responsavel || 'N/A'}</td>
                                <td>${decisao.prazo || 'N/A'}</td>
                                <td>${decisao.proximaReuniao || 'N/A'}</td>
                            </tr>
                        `).join('');
                        const decisoesTableFooter = `
                                    </tbody>
                                </table>
                            </div>
                        `;
                        decisoesHtml = decisoesTableHeader + decisoesTableRows + decisoesTableFooter;
                    }
                    
                    const identificacaoHtml = `
                        <h3 class="font-bold text-xl text-indigo-800">Identificação</h3>
                        <div class="grid md:grid-cols-2 gap-4 mt-4">
                            <div><strong>Empreendimento:</strong> ${data.identificacao?.empreendimento || 'N/A'}</div>
                            <div><strong>Responsável:</strong> ${data.identificacao?.responsavel || 'N/A'}</div>
                            <div><strong>Data de Preenchimento:</strong> ${data.identificacao?.dataPreenchimento || 'N/A'}</div>
                            <div><strong>Data de Atualização:</strong> ${data.identificacao?.dataAtualizacao || 'N/A'}</div>
                        </div>
                        <div class="mt-4">
                            <p><strong>Status Consolidado:</strong> ${data.identificacao?.statusConsolidado || 'N/A'}</p>
                            <p><strong>Situação dos Estudos:</strong> ${data.identificacao?.situacaoEstudos || 'N/A'}</p>
                            <p><strong>Interações com o Órgão:</strong> ${data.identificacao?.interacoesOrgao || 'N/A'}</p>
                            <p><strong>Pendências Técnicas:</strong> ${data.identificacao?.pendenciasTecnicas || 'N/A'}</p>
                            <p><strong>Observações Adicionais:</strong> ${data.identificacao?.observacoesAdicionais || 'N/A'}</p>
                        </div>
                    `;

                    recordElement.innerHTML = `
                        <div class="flex flex-col md:flex-row md:items-center justify-between mb-4">
                            <div class="collapsible-header flex items-center flex-grow cursor-pointer">
                                <span><span class="font-bold">Ficha de ${empreendimento} - ${responsavel}</span> - Salva em ${timestamp}</span>
                                <span class="ml-2">&#9660;</span>
                            </div>
                            <div class="flex space-x-2 mt-2 md:mt-0">
                                <button class="btn-secondary edit-record-btn" data-doc-id="${recordId}">Editar</button>
                                <button class="btn-secondary download-record-btn" data-doc-id="${recordId}">Baixar Ficha</button>
                                <button class="btn-secondary delete-record-btn" data-doc-id="${recordId}">Excluir</button>
                            </div>
                        </div>
                        <div class="collapsible-content-wrapper">
                            <div class="collapsible-content">
                                ${identificacaoHtml}
                                ${riscosHtml}
                                ${criticidadeHtml}
                                ${decisoesHtml}
                            </div>
                        </div>
                    `;
                    recordsList.appendChild(recordElement);
                });

                // Add event listeners for the new collapsible, edit, download and delete elements
                document.querySelectorAll('.collapsible-header').forEach(header => {
                    header.addEventListener('click', (e) => {
                        const recordItem = header.closest('.record-item');
                        const contentWrapper = recordItem.querySelector('.collapsible-content-wrapper');
                        const arrowSpan = header.querySelector('span:last-child');
                        
                        if (contentWrapper.style.maxHeight) {
                            contentWrapper.style.maxHeight = null;
                            arrowSpan.innerHTML = '&#9660;'; // down arrow
                        } else {
                            contentWrapper.style.maxHeight = contentWrapper.scrollHeight + 'px';
                            arrowSpan.innerHTML = '&#9650;'; // up arrow
                        }
                    });
                });
                
                document.querySelectorAll('.edit-record-btn').forEach(button => {
                    button.addEventListener('click', async (e) => {
                        const docId = e.target.getAttribute('data-doc-id');
                        showLoading();
                        try {
                            const docRef = doc(db, publicCollectionPath, docId);
                            const docSnap = await getDoc(docRef);
                            if (docSnap.exists()) {
                                const data = docSnap.data();
                                loadFormData({ ...data, docId });
                                allRecordsPanel.classList.add('hidden');
                                showMessage("Ficha carregada para edição!");
                            } else {
                                showMessage("Erro: Ficha não encontrada.");
                            }
                        } catch(e) {
                            console.error("Erro ao carregar documento para edição:", e);
                            showMessage("Erro ao carregar a ficha. Por favor, tente novamente.");
                        } finally {
                            hideLoading();
                        }
                    });
                });

                document.querySelectorAll('.download-record-btn').forEach(button => {
                    button.addEventListener('click', async (e) => {
                        const docId = e.target.getAttribute('data-doc-id');
                        showLoading();
                        try {
                            const docRef = doc(db, publicCollectionPath, docId);
                            const docSnap = await getDoc(docRef);

                            if (docSnap.exists()) {
                                const data = docSnap.data();
                                downloadAsDoc(data);
                                showMessage("Ficha baixada com sucesso!");
                            } else {
                                showMessage("Erro: Ficha não encontrada.");
                            }
                        } catch (e) {
                            console.error("Erro ao baixar documento: ", e);
                            showMessage("Erro ao baixar a ficha. Por favor, tente novamente.");
                        } finally {
                            hideLoading();
                        }
                    });
                });
                
                document.querySelectorAll('.delete-record-btn').forEach(button => {
                    button.addEventListener('click', async (e) => {
                        const docId = e.target.getAttribute('data-doc-id');
                        showLoading();
                        try {
                            const publicDocRef = doc(db, publicCollectionPath, docId);
                            const privateDocRef = doc(db, `/artifacts/${appId}/users/${userId}/fichas`, docId);
                            await deleteDoc(publicDocRef);
                            await deleteDoc(privateDocRef);
                            e.target.closest('.record-item').remove();
                            showMessage("Ficha deletada com sucesso.");
                            console.log("Documento deletado com ID:", docId);
                        } catch (e) {
                            console.error("Erro ao deletar documento: ", e);
                            showMessage("Erro ao deletar a ficha. Por favor, tente novamente.");
                        } finally {
                            hideLoading();
                        }
                    });
                });

            } catch (e) {
                console.error("Erro ao carregar todos os documentos: ", e);
                recordsList.innerHTML = '<p class="text-center text-red-500">Erro ao carregar os dados. Por favor, tente novamente.</p>';
            }
        });

        // Close all records panel
        closeAllRecordsBtn.addEventListener('click', () => {
            allRecordsPanel.classList.add('hidden');
        });

        // Initial setup
        setupAuthAndFirestore();
    </script>
</body>
</html>
